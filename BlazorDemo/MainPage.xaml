<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:blazor="clr-namespace:Microsoft.AspNetCore.Components.WebView.Maui;assembly=Microsoft.AspNetCore.Components.WebView.Maui"
             xmlns:local="clr-namespace:BlazorDemo"
             xmlns:components="clr-namespace:BlazorDemo.Components"
             x:Class="BlazorDemo.MainPage"
             BackgroundColor="#1E1E1E">
    <Grid RowDefinitions="Auto,*">
        <HorizontalStackLayout Grid.Row="0" Padding="12,8" Spacing="12" BackgroundColor="#512BD4">
            <Label Text="MAUI toolbar (Skia)" TextColor="White" FontAttributes="Bold" VerticalOptions="Center" />
            <Label x:Name="StatusLabel" Text="Blazor: starting" TextColor="#DDD" VerticalOptions="Center" />
        </HorizontalStackLayout>

        <blazor:BlazorWebView Grid.Row="1" x:Name="Blazor" HostPage="wwwroot/index.html"
                              BlazorWebViewInitialized="OnBlazorInitialized"
                              UrlLoading="OnUrlLoading">
            <blazor:BlazorWebView.RootComponents>
                <blazor:RootComponent Selector="#app" ComponentType="{x:Type components:Main}" />
            </blazor:BlazorWebView.RootComponents>
        </blazor:BlazorWebView>
    </Grid>
</ContentPage>
